{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "jest --runInBand",
    "test:coupons": "jest --runInBand --runTestsByPath test/coupons.test.js",
    "test:defects": "jest --config jest.defects.config.cjs --runInBand",
    "coupons:dry": "stryker run stryker.coupons.config.json --dryRunOnly",
    "tutorial:weak": "jest --config tutorial/jest.weak.config.cjs --runInBand",
    "tutorial:ai": "jest --config tutorial/jest.ai.config.cjs --runInBand",
    "tutorial:mutate:weak": "stryker run tutorial/stryker.weak.config.json",
    "tutorial:mutate:ai": "stryker run tutorial/stryker.ai.config.json",
    "mutate:cart-orders": "stryker run stryker.cart-orders.config.json",
    "test:auth": "jest --config jest.auth.config.cjs --runInBand",
    "test:defects:auth": "jest --config jest.auth-defects.config.cjs --runInBand"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "body-parser": "^2.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/jest-runner": "10.0.0",
    "jest": "30.5.2",
    "supertest": "7.3.1"
  },
  "jest": {
    "projects": [
      {
        "testEnvironment": "node",
        "setupFiles": [
          "<rootDir>/test/helpers/isolate.js"
        ],
        "testMatch": [
          "<rootDir>/test/cart-orders.test.js",
          "<rootDir>/test/coupons.test.js"
        ],
        "modulePathIgnorePatterns": [
          "<rootDir>/stryker-tmp/"
        ],
        "displayName": "cart-coupons"
      },
      "<rootDir>/jest.auth.config.cjs"
    ]
  },
  "allowScripts": {
    "sqlite3@6.0.1": true
  }
}
