{
  "$schema": "../node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "tutorial/eligibility.js"
  ],
  "jest": {
    "configFile": "tutorial/jest.ai.config.cjs"
  },
  "tempDirName": "stryker-tmp",
  "concurrency": 1,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/tutorial-ai/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/tutorial-ai/mutation.json"
  }
}

