{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "server.js:20-135"
  ],
  "tempDirName": "stryker-tmp",
  "concurrency": 2,
  "timeoutMS": 5000,
  "timeoutFactor": 1.5,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/auth/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/auth/mutation.json"
  },
  "jest": {
    "configFile": "jest.auth.config.cjs"
  }
}
