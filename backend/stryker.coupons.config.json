{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "mutate": [
    "server.js:355-492"
  ],
  "jest": {
    "config": {
      "testEnvironment": "node",
      "setupFiles": [
        "<rootDir>/test/helpers/isolate.js"
      ],
      "testMatch": [
        "**/test/coupons.test.js"
      ],
      "modulePathIgnorePatterns": [
        "<rootDir>/stryker-tmp/"
      ]
    }
  },
  "tempDirName": "stryker-tmp",
  "concurrency": 1,
  "reporters": [
    "clear-text",
    "html",
    "json"
  ],
  "htmlReporter": {
    "fileName": "reports/coupons/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/coupons/mutation.json"
  }
}

